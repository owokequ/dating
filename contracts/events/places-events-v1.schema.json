{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://owoke.app/contracts/events/places-events-v1.schema.json",
  "title": "Places events V1 payloads",
  "type": "object",
  "additionalProperties": false,
  "required": ["placeId", "cityCode", "name", "address", "category", "latitude", "longitude", "status"],
  "properties": {
    "placeId": {"type": "string", "format": "uuid"},
    "cityCode": {"const": "KZN"},
    "name": {"type": "string", "minLength": 1, "maxLength": 200},
    "address": {"type": "string", "minLength": 1, "maxLength": 500},
    "category": {"type": "string", "minLength": 1, "maxLength": 100},
    "latitude": {"type": "number", "minimum": -90, "maximum": 90},
    "longitude": {"type": "number", "minimum": -180, "maximum": 180},
    "priceLevel": {"type": ["integer", "null"], "minimum": 1, "maximum": 4},
    "status": {"enum": ["DRAFT", "ACTIVE", "ARCHIVED"]}
  }
}
