{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://owoke.app/contracts/events/event-envelope-v1.schema.json",
  "title": "Owoke Event Envelope V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["eventId", "eventType", "eventVersion", "aggregateId", "occurredAt", "correlationId", "payload"],
  "properties": {
    "eventId": {"type": "string", "format": "uuid"},
    "eventType": {"type": "string", "minLength": 1, "maxLength": 128},
    "eventVersion": {"const": 1},
    "aggregateId": {"type": "string", "minLength": 1, "maxLength": 128},
    "occurredAt": {"type": "string", "format": "date-time"},
    "correlationId": {"type": "string", "format": "uuid"},
    "payload": {"type": "object"}
  }
}
