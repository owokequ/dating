# Copy this file to .env.local. Real secrets must never be committed.

IDENTITY_DB_URL=jdbc:postgresql://localhost:15432/owoke_identity
IDENTITY_DB_USERNAME=owoke_identity
IDENTITY_DB_PASSWORD=owoke_identity
DATING_DB_URL=jdbc:postgresql://localhost:15433/owoke_dating
DATING_DB_USERNAME=owoke_dating
DATING_DB_PASSWORD=owoke_dating
NOTIFICATION_DB_URL=jdbc:postgresql://localhost:15434/owoke_notification
NOTIFICATION_DB_USERNAME=owoke_notification
NOTIFICATION_DB_PASSWORD=owoke_notification
PLACES_DB_URL=jdbc:postgresql://localhost:15435/owoke_places
PLACES_DB_USERNAME=owoke_places
PLACES_DB_PASSWORD=owoke_places
MEDIA_DB_URL=jdbc:postgresql://localhost:15436/owoke_media
MEDIA_DB_USERNAME=owoke_media
MEDIA_DB_PASSWORD=owoke_media
EVENTS_DB_URL=jdbc:postgresql://localhost:15437/owoke_events
EVENTS_DB_USERNAME=owoke_events
EVENTS_DB_PASSWORD=owoke_events
EVENTS_SERVICE_PORT=8086

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=dating-redis
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

WEB_APP_URL=http://localhost:5173
WEB_APP_ORIGIN=http://localhost:5173
# Comma-separated hostnames accepted by the Vite dev server when using a trusted tunnel.
VITE_DEV_ALLOWED_HOSTS=
IDENTITY_SERVICE_URL=http://localhost:8081
DATING_SERVICE_URL=http://localhost:8082
NOTIFICATION_SERVICE_URL=http://localhost:8083
PLACES_SERVICE_URL=http://localhost:8084
MEDIA_SERVICE_URL=http://localhost:8085
EVENTS_SERVICE_URL=http://localhost:8086
COOKIE_SECURE=false

# Leave empty to let identity-service generate an ephemeral local RSA key pair.
OWOKE_JWT_PRIVATE_KEY_BASE64=
OWOKE_JWT_PUBLIC_KEY_BASE64=

# Telegram OIDC remains optional. Keep the redirect URI equal to the one
# configured in BotFather and use the same localhost/127.0.0.1 hostname everywhere.
TELEGRAM_OIDC_CLIENT_ID=
TELEGRAM_OIDC_CLIENT_SECRET=
TELEGRAM_BOT_USERNAME=
TELEGRAM_OIDC_REDIRECT_URI=http://localhost:8080/api/v1/auth/telegram/callback

# Enable polling only after adding a real BotFather token.
TELEGRAM_BOT_ENABLED=false
TELEGRAM_BOT_MODE=polling
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Cloudflare site-availability Worker. Keep disabled locally until the Worker
# secret is configured.
SITE_AVAILABILITY_ENABLED=false
SITE_AVAILABILITY_WEBHOOK_SECRET=

MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS_ENABLE=false
MAIL_SMTP_STARTTLS_REQUIRED=false
MAIL_SMTP_CONNECTION_TIMEOUT=5000
MAIL_SMTP_READ_TIMEOUT=5000
MAIL_SMTP_WRITE_TIMEOUT=5000
NOTIFICATION_FROM_EMAIL=noreply@owoke.local
MAIL_HEALTH_ENABLED=false

TWO_GIS_ENABLED=false
TWO_GIS_SCHEDULE_ENABLED=false
TWO_GIS_API_KEY=
TWO_GIS_PAGE_SIZE=10
TWO_GIS_MAX_PAGES=1

KUDAGO_PLACES_ENABLED=true
KUDAGO_PLACES_PAGE_SIZE=100
KUDAGO_PLACES_FOOD_LIMIT=10
KUDAGO_PLACES_LEISURE_LIMIT=20
KUDAGO_EVENTS_ENABLED=true
KUDAGO_EVENTS_SCHEDULE_ENABLED=true
KUDAGO_EVENTS_SYNC_DELAY=PT6H
KUDAGO_EVENTS_HORIZON=P90D

MEDIA_S3_ENDPOINT=http://localhost:19000
MEDIA_S3_REGION=us-east-1
MEDIA_S3_BUCKET=owoke-media
MEDIA_S3_ACCESS_KEY=owoke-minio
MEDIA_S3_SECRET_KEY=owoke-minio-secret
MEDIA_S3_PATH_STYLE_ACCESS=true
