# Copy this file to .env.local. Real secrets must never be committed.

IDENTITY_DB_URL=jdbc:postgresql://localhost:15432/owoke_identity
IDENTITY_DB_USERNAME=owoke_identity
IDENTITY_DB_PASSWORD=owoke_identity
DATING_DB_URL=jdbc:postgresql://localhost:15433/owoke_dating
DATING_DB_USERNAME=owoke_dating
DATING_DB_PASSWORD=owoke_dating
NOTIFICATION_DB_URL=jdbc:postgresql://localhost:15434/owoke_notification
NOTIFICATION_DB_USERNAME=owoke_notification
NOTIFICATION_DB_PASSWORD=owoke_notification
PLACES_DB_URL=jdbc:postgresql://localhost:15435/owoke_places
PLACES_DB_USERNAME=owoke_places
PLACES_DB_PASSWORD=owoke_places

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=dating-redis
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

WEB_APP_URL=http://localhost:5173
WEB_APP_ORIGIN=http://localhost:5173
IDENTITY_SERVICE_URL=http://localhost:8081
DATING_SERVICE_URL=http://localhost:8082
NOTIFICATION_SERVICE_URL=http://localhost:8083
PLACES_SERVICE_URL=http://localhost:8084
COOKIE_SECURE=false

# Leave empty to let identity-service generate an ephemeral local RSA key pair.
OWOKE_JWT_PRIVATE_KEY_BASE64=
OWOKE_JWT_PUBLIC_KEY_BASE64=

# Telegram OIDC remains optional. Keep the redirect URI equal to the one
# configured in BotFather and use the same localhost/127.0.0.1 hostname everywhere.
TELEGRAM_OIDC_CLIENT_ID=
TELEGRAM_OIDC_CLIENT_SECRET=
TELEGRAM_BOT_USERNAME=
TELEGRAM_OIDC_REDIRECT_URI=http://localhost:8080/api/v1/auth/telegram/callback

# Enable polling only after adding a real BotFather token.
TELEGRAM_BOT_ENABLED=false
TELEGRAM_BOT_MODE=polling
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
NOTIFICATION_FROM_EMAIL=noreply@owoke.local
MAIL_HEALTH_ENABLED=false

TWO_GIS_ENABLED=false
TWO_GIS_API_KEY=
