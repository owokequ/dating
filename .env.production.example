OWOKE_DOMAIN=owoke.example.com
OWOKE_JWT_ISSUER=https://owoke.example.com
OWOKE_JWT_KEY_ID=owoke-prod-1
OWOKE_JWT_PRIVATE_KEY_BASE64=replace-with-pkcs8-private-key-base64
OWOKE_JWT_PUBLIC_KEY_BASE64=replace-with-x509-public-key-base64

IDENTITY_DB_PASSWORD=replace-with-random-password
DATING_DB_PASSWORD=replace-with-random-password
NOTIFICATION_DB_PASSWORD=replace-with-random-password
PLACES_DB_PASSWORD=replace-with-random-password
MEDIA_DB_PASSWORD=replace-with-random-password
EVENTS_DB_PASSWORD=replace-with-random-password
REDIS_USERNAME=owoke
REDIS_PASSWORD=replace-with-random-password
REDIS_ACL_FILE=/opt/owoke/secrets/redis-users.acl

TELEGRAM_BOT_ENABLED=true
TELEGRAM_BOT_TOKEN=replace-with-botfather-token
TELEGRAM_BOT_USERNAME=replace-with-bot-username
TELEGRAM_WEBHOOK_SECRET=replace-with-random-secret
# Cloudflare Worker sends public-availability recovery callbacks here. Keep
# this disabled until the shared secret is configured.
SITE_AVAILABILITY_ENABLED=false
SITE_AVAILABILITY_WEBHOOK_SECRET=replace-with-random-secret
TELEGRAM_OIDC_CLIENT_ID=replace-with-client-id
TELEGRAM_OIDC_CLIENT_SECRET=replace-with-client-secret
TWO_GIS_ENABLED=false
TWO_GIS_SCHEDULE_ENABLED=false
TWO_GIS_API_KEY=replace-after-license-review
TWO_GIS_PAGE_SIZE=10
TWO_GIS_MAX_PAGES=1
KUDAGO_PLACES_ENABLED=true
KUDAGO_EVENTS_ENABLED=true
KUDAGO_EVENTS_SCHEDULE_ENABLED=true
KUDAGO_EVENTS_SYNC_DELAY=PT6H
KUDAGO_EVENTS_HORIZON=P90D
MEDIA_S3_REGION=us-east-1
MEDIA_S3_BUCKET=owoke-media
MEDIA_S3_ACCESS_KEY=replace-with-random-access-key
MEDIA_S3_SECRET_KEY=replace-with-random-secret-key

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=replace-with-complete-gmail-address
MAIL_PASSWORD=replace-with-google-app-password
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS_ENABLE=true
MAIL_SMTP_STARTTLS_REQUIRED=true
MAIL_SMTP_CONNECTION_TIMEOUT=5000
MAIL_SMTP_READ_TIMEOUT=5000
MAIL_SMTP_WRITE_TIMEOUT=5000
MAIL_HEALTH_ENABLED=false
NOTIFICATION_FROM_EMAIL=replace-with-complete-gmail-address
GRAFANA_ADMIN_PASSWORD=replace-with-random-password
