{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "for-my-l-site-availability",
  "main": "src/index.js",
  "compatibility_date": "2026-08-04",
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "AVAILABILITY_MONITOR",
        "class_name": "AvailabilityMonitor"
      }
    ]
  },
  "exports": {
    "AvailabilityMonitor": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
